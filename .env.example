# Copy to .env.local (never commit real values).
# Browser-safe values only: anything prefixed VITE_ is shipped to users.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets go in Supabase Edge Function secrets, NOT here:
#   supabase secrets set ANTHROPIC_API_KEY=... STRIPE_SECRET_KEY=... (later milestones)
